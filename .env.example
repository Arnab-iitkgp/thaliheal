# ThaliHeal environment variables.
# Copy to .env.local for local development (it is git ignored), and set the same names in
# Vercel: Project, Settings, Environment Variables. Never put real values in this file.

# ---------- The switch ----------
# Scan off mode is the default: leave AI_ENABLED unset (or false) and the site needs NO variables at all.
# Photo scanning, the assistant and test mode then show "coming soon"; everything else works.
# Set it to true (exactly) to turn AI on. Then set an API key for your chosen provider below.
AI_ENABLED=true

# ======================== AI Provider Configuration ========================

# ---------- Provider Selection ----------
# Supported providers:
#   - gemini    : Google Gemini API (Recommended - FREE tier on Google AI Studio!)
#   - groq      : Groq Cloud (Fast & FREE Llama 3.2 Vision models on console.groq.com)
#   - anthropic : Claude API (console.anthropic.com)
#   - openai    : OpenAI or any OpenAI-compatible API
#
# If AI_PROVIDER is left blank, it auto-detects based on which API key you provide.
AI_PROVIDER=gemini

# 1. Google Gemini (FREE tier available at https://aistudio.google.com)
# Supports multiple keys for automatic rotation and quota multiplication:
GEMINI_API_KEY=
# Optional additional keys (rotates automatically, fails over on 429 quota exhaustion):
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# 2. Groq (FREE tier available at https://console.groq.com)
# Acts as high-speed automatic fallback when Gemini is busy or rate-limited!
GROQ_API_KEY=

# Automatic cross-provider fallback (true by default)
AI_FALLBACK=true

# 3. Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# 4. OpenAI / Custom (Optional)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---------- Optional: Custom Models per Tier ----------
# Defaults for Gemini (all free on AI Studio):
#   AI_MODEL_QUICK=gemini-1.5-flash
#   AI_MODEL_DEFAULT=gemini-1.5-flash
#   AI_MODEL_COMPLEX=gemini-1.5-pro
#
# Defaults for Groq:
#   AI_MODEL_QUICK=llama-3.2-11b-vision-preview
#   AI_MODEL_DEFAULT=llama-3.2-11b-vision-preview
#   AI_MODEL_COMPLEX=llama-3.2-90b-vision-preview
#
# Defaults for Anthropic:
#   AI_MODEL_QUICK=claude-haiku-5-5
#   AI_MODEL_DEFAULT=claude-sonnet-5-5
#   AI_MODEL_COMPLEX=claude-opus-5-5
AI_MODEL_QUICK=
AI_MODEL_DEFAULT=
AI_MODEL_COMPLEX=

# ======================== Server & Rate Limiting ========================

# ---------- Required on Vercel (Production and Preview) ----------
# Your site's address(es), comma separated, no trailing slash. Requests from anywhere else are refused.
# A * stands for one run of letters, digits and dashes, which covers Vercel preview addresses.
# https addresses only: on Vercel, an http origin is always refused.
ALLOWED_ORIGINS=https://your-project.vercel.app,https://your-project-*.vercel.app

# Upstash Redis REST credentials for shared rate limit counters.
# Adding "Upstash for Redis" from the Vercel Marketplace sets KV_REST_API_URL and KV_REST_API_TOKEN for you;
# either pair of names works. Leave empty locally to use in memory counters.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Random secret (at least 16 characters) used to hash IP addresses for rate limiting.
# Make one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
RATE_LIMIT_SALT=

# ---------- Optional: limits (defaults shown) ----------
# AI calls per person (one IP address) per minute and per day. Days reset at midnight IST.
RATE_LIMIT_PER_MINUTE=6
RATE_LIMIT_PER_DAY=60
# AI calls per day across all users: the hard ceiling on your daily bill.
GLOBAL_DAILY_LIMIT=500
# Largest request in bytes (Vercel's own cap is 4.5 MB), largest photo, photos per request,
# longest prompt in characters, and most output tokens per reply.
MAX_BODY_BYTES=2500000
MAX_IMAGE_BYTES=1800000
MAX_IMAGES=1
MAX_PROMPT_CHARS=40000
MAX_OUTPUT_TOKENS=2000

# ---------- Optional: owner testing ----------
# A long random secret. Enter the same value under Settings, Tester key on the deployed site
# to run test mode with higher limits and the strongest model. Leave empty to disable.
TESTER_TOKEN=

# Zeno Live audition runs on localhost with GEMINI_API_KEY. Hosted access is opt-in
# and requires TESTER_TOKEN, an exact ALLOWED_ORIGINS entry, and the Redis settings above.
ZENO_LIVE_ENABLED=false
# Optional exact HTTPS origin for rate-limited Zeno text and voice on the local dev server.
# Both chat workspaces are available at this origin when their providers are configured.
ZENO_LIVE_DEMO_ORIGIN=
# Optional personal voice on localhost and the exact HTTPS preview origin above.
# Use a Gemini key from a billing-enabled project for personal meal data.
ZENO_LIVE_PERSONAL_KEY=
# Hosted Zeno text pilot also requires GROQ_API_KEY and the same tester settings.
ZENO_AGENT_ENABLED=false
# ZENO_TEXT_MODEL=openai/gpt-oss-120b
# ZENO_LIVE_MODEL=gemini-3.8-live
TESTER_PER_MINUTE=30
TESTER_PER_DAY=400
